      var key=String(site.id);
      var gen=siteHistoryGen;
      if(!offset){
        var hit=cachedSiteHistory(key);
        // 기억해 둔 값이 있으면 네트워크를 타지 않고 그대로 그린다.
        if(hit)return Promise.resolve(hit);
      }
      return publicationFetch('/reports/site/'+encodeURIComponent(site.id)+'?limit='+SITE_HISTORY_PAGE+'&offset='+offset).then(function(data){
        if(!publicationDataAllowed(data)||data.ok!==true||!Array.isArray(data.history))throw new Error('site history invalid');
        if(gen!==siteHistoryGen){if(retried)return null;return fetchSiteHistory(site,offset,true);}
        if(!offset)siteHistoryCache[key]={at:Date.now(),data:data};return data;
      }).catch(function(){return null;});
    }
