  "tideWorkflowTriggerBlock": "  push:\n    branches:\n      - main\n    paths:\n      - \".github/scripts/update_tide.py\"\n      - \".github/scripts/audit_tide_health.py\"\n      - \".github/scripts/build_tide_station_mapping.py\"\n      - \".github/scripts/tide_official_stations.json\"\n      - \".github/scripts/test_tide.py\"\n      - \".github/scripts/test_tide_fallback.mjs\"\n      - \"tide_station_mapping.json\"\n      - \".github/workflows/update-tide.yml\"\n      - \"data/birdmap_latest_v24_MasterDB_조석연동_업데이트용.xlsx\"\n  schedule:\n    # GitHub Actions cron uses UTC. 15:05 UTC is 00:05 KST the following day.\n    - cron: \"5 15 * * *\"\n    # Backup refresh: 21:05 UTC is 06:05 KST, preventing stale daily tide data if the midnight run is missed or conflicts.\n    - cron: \"5 21 * * *\"\n    # Recovery refreshes: 23:35/01:35 UTC are 08:35/10:35 KST; complete data makes them no-ops.\n    - cron: \"35 23 * * *\"\n    - cron: \"35 1 * * *\"\n  workflow_dispatch:\n\n",
