+/* 티맵 앱 딥링크: goalx=경도, goaly=위도. 보호 위치는 호출부에서 제외한다. */
+function tmapNavigationUrl(dest,name){
+  if(!dest||dest.lat===undefined||dest.lon===undefined||dest.lat===null||dest.lon===null)return '';
+  var lat=Number(dest.lat),lon=Number(dest.lon);
+  if(!isFinite(lat)||!isFinite(lon)||lat<-90||lat>90||lon<-180||lon>180||(lat===0&&lon===0))return '';
+  return 'tmap://route?goalname='+encodeURIComponent(name||'탐조지')+'&goalx='+lon+'&goaly='+lat;
+}
+function openTmapNavigation(){
+  if(!/Android|iPhone|iPad|iPod/i.test(navigator.userAgent)){
+    alert('티맵 내비게이션은 티맵이 설치된 스마트폰에서 이용해 주세요.');
+    return false;
+  }
+  return true;
+}
+function tmapNavigationLink(dest,name,cls,text){
+  var url=tmapNavigationUrl(dest,name);
+  return url?'<a class="'+cls+'" href="'+escapeHtml(url)+'" onclick="return openTmapNavigation()" title="티맵 앱이 설치된 스마트폰에서 열기">'+text+'</a>':'';
+}
+function spotTmapRouteHtml(dest){
+  return tmapNavigationLink(dest,'출현 지점','spotTmapRoute','🚙 티맵');
+}
